      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Shared secret: must match N8N_WEBHOOK_SECRET in Vercel.\nconst SECRET = 'CHANGE_ME_LONG_RANDOM_STRING';\n\nconst req = $input.first().json;\nconst headers = req.headers || {};\nconst b = req.body || {};\n\nconst clean = (v, max) => String(v ?? '').trim().slice(0, max);\nconst email = clean(b.email, 254).toLowerCase();\nconst name = clean(b.name, 60);\n\nlet reason = '';\nif (headers['x-webhook-secret'] !== SECRET) reason = 'unauthorized';\nelse if (!name) reason = 'name_required';\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) reason = 'email_invalid';\nelse if (b.consent !== true) reason = 'consent_required';\n\nreturn [{\n  json: {\n    valid: reason === '',\n    reason,\n    name,\n    email,\n    consent: b.consent === true,\n    timezone: clean(b.timezone, 64),\n    locale: clean(b.locale, 16),\n    country: clean(b.country, 8),\n    source: 'Softbloom app',\n    submittedAt: clean(b.submittedAt, 40) || new Date().toISOString(),\n  },\n}];"
      }
    },
    {

      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Shared secret: must match N8N_WEBHOOK_SECRET in Vercel (same value as in the subscribe workflow).\nconst SECRET = 'CHANGE_ME_LONG_RANDOM_STRING';\n\nconst req = $input.first().json;\nconst headers = req.headers || {};\nconst b = req.body || {};\nconst email = String(b.email ?? '').trim().toLowerCase().slice(0, 254);\n\nlet reason = '';\nif (headers['x-webhook-secret'] !== SECRET) reason = 'unauthorized';\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) reason = 'email_invalid';\n\nreturn [{\n  json: {\n    valid: reason === '',\n    reason,\n    email,\n    unsubscribedAt: String(b.unsubscribedAt ?? '').slice(0, 40) || new Date().toISOString(),\n  },\n}];"
      }
    },
    {
      "id": "f078fa11-2ed8-4d5a-811f-be4e47bf29ad",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
